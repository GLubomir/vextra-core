#. Plugin Name of the plugin
#: vextra-core.php
msgid "Vextra Core"
msgstr "Vextra Core"

#. Description of the plugin
#: vextra-core.php
msgid "Business logic for the Vextra WooCommerce store: modules, guarded integrations, shared support code."
msgstr "Бизнес-логика магазина Vextra на WooCommerce: модули, защищённые интеграции, общий код."

#. Author of the plugin
#: vextra-core.php
msgid "Vextra"
msgstr "Vextra"

#: src/Admin/Notices.php:45
msgid "vextra-core потребує WooCommerce"
msgstr "vextra-core требует WooCommerce"

#: src/Admin/Notices.php:48
msgid "vextra-core: не знайдено vendor/autoload.php. Виконайте composer install у теці плагіна."
msgstr "vextra-core: не найден vendor/autoload.php. Выполните composer install в папке плагина."

#. translators: %s: PHP version
#: src/Lifecycle.php:22
#, php-format
msgid "vextra-core потребує PHP %s або новішої версії."
msgstr "vextra-core требует PHP %s или новее."

#. translators: %s: WordPress version
#: src/Lifecycle.php:26
#, php-format
msgid "vextra-core потребує WordPress %s або новішої версії."
msgstr "vextra-core требует WordPress %s или новее."

#: src/Guard/Responder.php
msgid "Забагато запитів. Спробуйте за кілька секунд."
msgstr "Слишком много запросов. Повторите через несколько секунд."

#: src/Guard/Responder.php
msgid "Забагато запитів"
msgstr "Слишком много запросов"

#: src/Compat/Conflicts.php
msgid "Активний другий SEO-плагін: підтримуваний лише Rank Math"
msgstr "Активен второй SEO-плагин: поддерживается только Rank Math"

#: src/Compat/Conflicts.php
msgid "Деактивуйте плагін, що дублює Rank Math (title, schema, sitemap, редиректи)."
msgstr "Деактивируйте плагин, дублирующий Rank Math (title, schema, sitemap, редиректы)."

#: src/Compat/Conflicts.php
msgid "Активний інший мультимовний плагін: модуль multilang вимкнено"
msgstr "Активен другой мультиязычный плагин: модуль multilang отключён"

#: src/Compat/Conflicts.php
msgid "Підтримуваний мультимовний плагін — Polylang. Деактивуйте конфліктний плагін, модуль увімкнеться сам."
msgstr "Поддерживаемый мультиязычный плагин — Polylang. Деактивируйте конфликтующий плагин, модуль включится сам."

#: src/Compat/Conflicts.php
msgid "Активний плагін редиректів поруч із редиректами vextra-core"
msgstr "Активен плагин редиректов рядом с редиректами vextra-core"

#: src/Compat/Conflicts.php
msgid "Редиректи слагів і термінів веде vextra-core (через Rank Math). Перевірте, що правила не дублюються."
msgstr "Редиректы слагов и терминов ведёт vextra-core (через Rank Math). Проверьте, что правила не дублируются."

#: src/Compat/Conflicts.php
msgid "Активний плагін списку бажань (власна функція планується)"
msgstr "Активен плагин списка желаний (собственная функция планируется)"

#: src/Compat/Conflicts.php
msgid "Інформаційно: після появи власного списку бажань плагін доведеться вимкнути."
msgstr "Информационно: после появления собственного списка желаний плагин придётся отключить."

#: src/Compat/Conflicts.php
msgid "Активний плагін безпеки з лімітами запитів поруч із модулем guard"
msgstr "Активен плагин безопасности с лимитами запросов рядом с модулем guard"

#: src/Compat/Conflicts.php
msgid "Вимкніть у плагіні безпеки ліміти запитів і правила robots.txt, щоб не подвоювати 429/403."
msgstr "Отключите в плагине безопасности лимиты запросов и правила robots.txt, чтобы не дублировать 429/403."

#: src/Compat/Conflicts.php
msgid "У Rank Math заповнено редактор robots.txt: він замінює базовий текст, у якому guard об’єднує свої правила"
msgstr "В Rank Math заполнен редактор robots.txt: он заменяет базовый текст, в который guard объединяет свои правила"

#: src/Compat/Conflicts.php
msgid "Залиште в редакторі рядок «Sitemap:» або очистіть редактор (Rank Math → Загальні налаштування → Редактор robots.txt)."
msgstr "Оставьте в редакторе строку «Sitemap:» или очистите редактор (Rank Math → Общие настройки → Редактор robots.txt)."

#. translators: %s: module id
#: src/Admin/ConflictNotices.php
#, php-format
msgid "Модуль «%s» вимкнено."
msgstr "Модуль «%s» отключён."

#: src/Security/GenericErrors.php
msgid "Невірний логін або пароль."
msgstr "Неверный логин или пароль."

#. translators: %d: minutes until the next attempt is allowed.
#: src/Security/LoginThrottle.php
#, php-format
msgid "Забагато спроб входу. Спробуйте за %d хв."
msgstr "Слишком много попыток входа. Попробуйте через %d мин."

#: src/Security/LostPassword.php
msgid "Якщо такий обліковий запис існує, ми надіслали лист із інструкціями."
msgstr "Если такая учётная запись существует, мы отправили письмо с инструкциями."

#: src/Compat/Conflicts.php
msgid "Активний плагін захисту входу поряд із модулем security (ліміти спроб входу, XML-RPC, версії)"
msgstr "Активен плагин защиты входа рядом с модулем security (лимиты попыток входа, XML-RPC, версии)"

#: src/Compat/Conflicts.php
msgid "Задайте VX_SECURITY_LOGIN_IP_LIMIT і VX_SECURITY_LOGIN_USER_LIMIT = 0 у wp-config.php або вимкніть інший плагін, щоб не подвоювати блокування входу."
msgstr "Задайте VX_SECURITY_LOGIN_IP_LIMIT и VX_SECURITY_LOGIN_USER_LIMIT = 0 в wp-config.php или отключите другой плагин, чтобы не дублировать блокировку входа."

#: src/Compat/Conflicts.php
msgid "У Rank Math не вимкнено архіви авторів: логін автора може потрапити в індекс"
msgstr "В Rank Math не отключены архивы авторов: логин автора может попасть в индекс"

#: src/Compat/Conflicts.php
msgid "Rank Math → Заголовки та мета → Автори → «Вимкнути архіви авторів» увімкнути."
msgstr "Rank Math → Заголовки и мета → Авторы → включить «Отключить архивы авторов»."

#: src/Compat/Conflicts.php
msgid "Активний другий плагін двофакторної автентифікації поряд із «Two Factor»"
msgstr "Активен второй плагин двухфакторной аутентификации рядом с «Two Factor»"

#: src/Compat/Conflicts.php
msgid "Залиште один плагін 2FA (підтримуваний: «Two Factor»): два плагіни борються за хуки authenticate / wp_login."
msgstr "Оставьте один плагин 2FA (поддерживаемый: «Two Factor»): два плагина конфликтуют за хуки authenticate / wp_login."

#: src/Compat/Conflicts.php
msgid "Активний плагін капчі / Turnstile поряд із вбудованою перевіркою vextra-core"
msgstr "Активен плагин капчи / Turnstile рядом со встроенной проверкой vextra-core"

#: src/Compat/Conflicts.php
msgid "Вимкніть капчу на формах входу в іншому плагіні або деактивуйте його: інакше на формі буде два віджети."
msgstr "Отключите капчу на формах входа в другом плагине или деактивируйте его: иначе на форме будет два виджета."

#: src/Compat/Conflicts.php
msgid "ЗАПУСК ЗАБЛОКОВАНО: персонал без двофакторної автентифікації"
msgstr "ЗАПУСК ЗАБЛОКИРОВАН: персонал без двухфакторной аутентификации"

#: src/Compat/Conflicts.php
msgid "Активуйте плагін «Two Factor» і налаштуйте TOTP + резервні коди кожному користувачу з правами керування (профіль → Two-Factor Options). Обов’язково до запуску."
msgstr "Активируйте плагин «Two Factor» и настройте TOTP + резервные коды каждому пользователю с правами управления (профиль → Two-Factor Options). Обязательно до запуска."

#: src/Compat/Conflicts.php
msgid "плагін «Two Factor» не активний"
msgstr "плагин «Two Factor» не активен"

#: src/Integrations/Turnstile/Turnstile.php
msgid "Увімкніть JavaScript, щоб пройти перевірку «я не робот»."
msgstr "Включите JavaScript, чтобы пройти проверку «я не робот»."

#: src/Security/OwnerBotRole.php
msgid "Vextra: власний агент"
msgstr "Vextra: собственный агент"

#: src/Security/TurnstileForms.php
msgid "Підтвердіть, що ви не робот і спробуйте ще раз."
msgstr "Подтвердите, что вы не робот, и попробуйте ещё раз."

#: src/Security/TwoFactorPolicy.php
msgid "Двофакторну автентифікацію персоналу не увімкнено: активуйте плагін «Two Factor» (Плагіни)."
msgstr "Двухфакторная аутентификация персонала не включена: активируйте плагин «Two Factor» (Плагины)."

#: src/Security/TwoFactorPolicy.php
msgid "Ваш обліковий запис керування магазином ще не захищений двофакторною автентифікацією. Налаштуйте додаток-автентифікатор (TOTP) та резервні коди у своєму профілі."
msgstr "Ваша учётная запись управления магазином ещё не защищена двухфакторной аутентификацией. Настройте приложение-аутентификатор (TOTP) и резервные коды в своём профиле."

#: src/Security/TwoFactorPolicy.php
msgid "Налаштувати зараз"
msgstr "Настроить сейчас"

#: src/Security/TwoFactorPolicy.php
msgid "Приховати до наступного входу"
msgstr "Скрыть до следующего входа"

#: src/Security/OwnerBotRole.php
msgid "Ця дія недоступна для службового облікового запису."
msgstr "Это действие недоступно для служебной учётной записи."

#: src/Reviews/Policy.php
msgid "Оберіть оцінку від 1 до 5."
msgstr "Выберите оценку от 1 до 5."

#. translators: 1: minimum, 2: maximum number of characters.
#: src/Reviews/Policy.php
msgid "Відгук має містити від %1$d до %2$d символів."
msgstr "Отзыв должен содержать от %1$d до %2$d символов."

#: src/Reviews/Policy.php
msgid "Посилання у відгуках заборонені."
msgstr "Ссылки в отзывах запрещены."

#: src/Reviews/Policy.php
msgid "Щоб залишити відгук, увійдіть в особистий кабінет."
msgstr "Чтобы оставить отзыв, войдите в личный кабинет."

#: src/Reviews/Policy.php
#: src/Reviews/Gate.php
msgid "Відгуки до цього матеріалу закриті."
msgstr "Отзывы к этому материалу закрыты."

#: src/Reviews/Policy.php
#: src/Reviews/Form.php
msgid "Відгук можуть залишити лише покупці цього товару."
msgstr "Отзыв могут оставить только покупатели этого товара."

#: src/Reviews/Policy.php
#: src/Reviews/Form.php
msgid "Ви вже залишили відгук на цей товар."
msgstr "Вы уже оставили отзыв на этот товар."

#: src/Reviews/Policy.php
msgid "Покупець"
msgstr "Покупатель"

#: src/Reviews/Gate.php
msgid "Відгук не прийнято"
msgstr "Отзыв не принят"

#: src/Reviews/Form.php
msgid "Увійдіть, щоб залишити відгук"
msgstr "Войдите, чтобы оставить отзыв"

#: src/Compat/Conflicts.php
msgid "Активний плагін відгуків / коментарів поряд із політикою відгуків vextra-core"
msgstr "Активен плагин отзывов / комментариев рядом с политикой отзывов vextra-core"

#: src/Compat/Conflicts.php
msgid "Політика відгуків (лише покупці, модерація, ліміти) діє попри плагін, але його форма й REST-маршрути можуть її обходити: деактивуйте плагін."
msgstr "Политика отзывов (только покупатели, модерация, лимиты) действует несмотря на плагин, но его форма и REST-маршруты могут её обходить: деактивируйте плагин."

#: src/Compat/Conflicts.php
msgid "Налаштування коментарів / відгуків не збігаються з політикою vextra-core"
msgstr "Настройки комментариев / отзывов не совпадают с политикой vextra-core"

#: src/Compat/Conflicts.php
msgid "Виконайте `wp vextra reviews reconcile` (значення в БД). Якщо розбіжність лишається, плагін фільтрує опцію через option_* / pre_option_*: вимкніть цей фільтр."
msgstr "Выполните `wp vextra reviews reconcile` (значения в БД). Если расхождение остаётся, плагин фильтрует опцию через option_* / pre_option_*: отключите этот фильтр."

#: src/Reviews/Gate.php
msgid "Форма застаріла. Оновіть сторінку й спробуйте ще раз."
msgstr "Форма устарела. Обновите страницу и попробуйте ещё раз."

#: src/Compat/Conflicts.php
msgid "Rank Math «Auto Post Redirect» вимкнено: редиректи змінених слагів не створюються"
msgstr "В Rank Math выключен «Auto Post Redirect»: редиректы изменённых слагов не создаются"

#: src/Compat/Conflicts.php
msgid "Rank Math → Загальні налаштування → Редиректи → «Auto Post Redirect» має бути увімкнено (або `wp vextra seo apply-config`)."
msgstr "Rank Math → Общие настройки → Редиректы → «Auto Post Redirect» должен быть включён (или `wp vextra seo apply-config`)."

#: src/Compat/Conflicts.php
msgid "Редирект сторінок вкладень Rank Math вимкнено або веде не на головну сайту"
msgstr "Редирект страниц вложений Rank Math выключен или ведёт не на главную сайта"

#: src/Compat/Conflicts.php
msgid "Rank Math → Загальні налаштування → Посилання → «Redirect Attachments» увімкнено, адреса за замовчуванням = головна сайту (або `wp vextra seo apply-config`)."
msgstr "Rank Math → Общие настройки → Ссылки → «Redirect Attachments» включено, адрес по умолчанию = главная сайта (или `wp vextra seo apply-config`)."

#: src/Compat/Conflicts.php
msgid "Активний плагін транслітерації: модуль seo-urls (слаги й імена файлів) вимкнено"
msgstr "Активен плагин транслитерации: модуль seo-urls (слаги и имена файлов) выключен"

#: src/Compat/Conflicts.php
msgid "Транслітерацію веде vextra-core з таблицями UA/RU за мовою об’єкта. Деактивуйте плагін, модуль увімкнеться сам."
msgstr "Транслитерацию ведёт vextra-core с таблицами UA/RU по языку объекта. Деактивируйте плагин, модуль включится сам."

msgid "Економія %s"
msgstr "Экономия %s"

