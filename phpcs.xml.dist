<?xml version="1.0"?>
<ruleset name="Vextra Core">
	<description>Vextra Core plugin coding standards.</description>

	<file>.</file>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/languages/*</exclude-pattern>
	<exclude-pattern>*/scripts/dev/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="ps"/>

	<config name="testVersion" value="8.1-"/>
	<config name="minimum_wp_version" value="7.1"/>

	<rule ref="WordPress">
		<exclude name="WordPress.Files.FileName"/>
		<exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
		<exclude name="Generic.Arrays.DisallowShortArraySyntax"/>
		<!-- PrefixAllGlobals rejects prefixes shorter than 3 chars (our vx_/VX_ convention); enforced by review. -->
		<exclude name="WordPress.NamingConventions.PrefixAllGlobals"/>
		<exclude name="Squiz.Commenting.ClassComment"/>
		<exclude name="Squiz.Commenting.FunctionComment.Missing"/>
	</rule>
	<rule ref="PHPCompatibilityWP"/>

	<!-- Allow slash-separated hook names: vextra/area/name. -->
	<rule ref="WordPress.NamingConventions.ValidHookName">
		<properties>
			<property name="additionalWordDelimiters" value="/"/>
		</properties>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="vextra-core"/>
			</property>
		</properties>
	</rule>
</ruleset>
